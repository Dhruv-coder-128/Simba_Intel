.venv/
venv/
__pycache__/
*.pyc
.git/
.vscode/
.idea/
.claude/

# Database - never bake a data dump/backup into the image
db.sqlite3
db.sqlite3.*
*.sqlite3
legacy_data.json

# Static files build output (collectstatic) - regenerated by the Dockerfile
# CMD itself on every container start, so a stale host-side copy must never
# be copied in ahead of that.
staticfiles/

# Transient upload scratch space (chat/views.py's _extract_attachment_text
# writes here, then deletes the file right after use - os.makedirs(...,
# exist_ok=True) creates the directory itself on first use, so nothing here
# needs to be pre-seeded) - never bake host-side contents into the image.
uploads/*
!uploads/.gitkeep

# A different, unrelated directory (not the one code above writes to) that
# only ever accumulated stray manually-tested files - not needed at runtime
# at all.
chat/uploads/

.env
*.log

# Docs/meta files - not needed for the app to run, no reason to bloat the
# build context or image with them.
docs/
*.md
render.yaml
docker-compose.yml
