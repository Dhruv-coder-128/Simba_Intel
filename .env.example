
# Django Settings
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-0dxud_bzn1-j5*+avl*c7ossn*qcsin#*36(l#y04xzyv$nur8
ALLOWED_HOSTS=localhost,127.0.0.1,simba-intel.onrender.com
SITE_ID=1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://simba-intel.onrender.com

# Google OAuth is NOT configured via env vars - allauth reads the Client
# ID/Secret from a SocialApp row in Django admin
# (/admin/socialaccount/socialapp/), tied to the Site matching SITE_ID above.

# AI Provider API Keys
GROQ_API_KEY=your-groq-api-key
MISTRAL_API_KEY=your-mistral-api-key
TAVILY_API_KEY=your-tavily-api-key

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
# Console backend by default even in production - set this explicitly to
# actually send mail once the credentials above are real:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# "none" = no verification tracked. "optional" = emails sent and tracked,
# but login isn't blocked - this is what chat/services/verification.py's
# in-app feature gating (image gen/Vision/Settings) expects. "mandatory"
# blocks login itself for unverified users (a stricter, different product).
ACCOUNT_EMAIL_VERIFICATION=none

# Database - PostgreSQL only, there is no SQLite fallback. Either set
# DATABASE_URL directly (what Render/Supabase/Neon/Heroku all hand you as one
# connection string - required in production):
# DATABASE_URL=postgres://user:password@host:5432/dbname
#
# ...or, for local development, leave DATABASE_URL unset and point these at a
# local `createdb simba_intel` instead (defaults below already match Postgres's
# own out-of-the-box local conventions, so most devs can leave them as-is):
POSTGRES_DB=simba_intel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# RBAC (chat/permissions.py) - which account gets promoted to Role.OWNER by
# chat/migrations/0023_promote_owner_and_backfill_roles.py. Leave unset
# locally (it falls back to the earliest-created superuser); set it for
# real before running that migration against a shared/production database.
# OWNER_EMAIL=

# Error tracking (optional) - only activates if sentry-sdk is installed too
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Logging verbosity for Django's own logger (DEBUG/INFO/WARNING/ERROR)
DJANGO_LOG_LEVEL=INFO
