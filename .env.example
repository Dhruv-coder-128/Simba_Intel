
# Django Settings
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-0dxud_bzn1-j5*+avl*c7ossn*qcsin#*36(l#y04xzyv$nur8
ALLOWED_HOSTS=localhost,127.0.0.1,simba-intel.onrender.com
SITE_ID=1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://simba-intel.onrender.com

# Google OAuth - allauth itself still reads the Client ID/Secret from a
# SocialApp row (tied to the Site matching SITE_ID above), not from these
# two directly. chat/migrations/0025_setup_google_socialapp.py reads these
# once per deploy to create/update that row automatically - set them here,
# then run `python manage.py migrate` (or `python manage.py setup_google_oauth`
# to re-sync later without a new migration, e.g. after rotating the secret).
# Get credentials from https://console.cloud.google.com/apis/credentials
# (authorized redirect URI: <your-domain>/accounts/google/login/callback/).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI Provider API Keys
GROQ_API_KEY=your-groq-api-key
MISTRAL_API_KEY=your-mistral-api-key
TAVILY_API_KEY=your-tavily-api-key
# Powers "Quantum Core" (chat/providers/nvidia_text_provider.py,
# chat/providers/nvidia_vision_provider.py) - free tier, get a key at
# https://build.nvidia.com (API Catalog > any model > Get API Key).
NVIDIA_API_KEY=your-nvidia-api-key

# Email Configuration - Resend API (SMTP is not usable at all from Render;
# see chat/services/resend_backend.py). Get an API key from
# https://resend.com/api-keys.
RESEND_API_KEY=your-resend-api-key
# onboarding@resend.dev works without a verified sending domain, useful for
# a first run - replace with a real address on a domain verified in the
# Resend dashboard once ready.
DEFAULT_FROM_EMAIL=onboarding@resend.dev
# Defaults to the Resend backend already - only set this to override, e.g.
# to the console backend for local debugging without a real API key:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# "none" = no verification tracked. "optional" = emails sent and tracked,
# but login isn't blocked - this is what chat/services/verification.py's
# in-app feature gating (image gen/Vision/Settings) expects. "mandatory"
# blocks login itself for unverified users (a stricter, different product).
ACCOUNT_EMAIL_VERIFICATION=none

# Database - PostgreSQL only, there is no SQLite fallback. Either set
# DATABASE_URL directly (what Render/Supabase/Neon/Heroku all hand you as one
# connection string - required in production):
# DATABASE_URL=postgres://user:password@host:5432/dbname
#
# ...or, for local development, leave DATABASE_URL unset and point these at a
# local `createdb simba_intel` instead (defaults below already match Postgres's
# own out-of-the-box local conventions, so most devs can leave them as-is):
POSTGRES_DB=simba_intel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# RBAC (chat/permissions.py) - which account gets promoted to Role.OWNER by
# chat/migrations/0023_promote_owner_and_backfill_roles.py. Leave unset
# locally (it falls back to the earliest-created superuser); set it for
# real before running that migration against a shared/production database.
# OWNER_EMAIL=

# Error tracking (optional) - only activates if sentry-sdk is installed too
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Logging verbosity for Django's own logger (DEBUG/INFO/WARNING/ERROR)
DJANGO_LOG_LEVEL=INFO
