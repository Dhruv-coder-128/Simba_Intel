{% extends "account/base.html" %}
{% load i18n %}

{% block title %}{% trans "Password Reset Sent" %}{% endblock %}

{% block content %}
    <div class="auth-header">
        <div class="auth-logo">
            <i class="fa-solid fa-terminal"></i>
            <h1>SIMBA_INTEL</h1>
        </div>
        <p class="auth-subtitle">PASSWORD RESET SENT</p>
    </div>

    <p class="auth-footer" style="margin-bottom:20px; color: rgba(255,255,255,0.6);">
        {% trans "We have sent you an e‑mail containing a link to reset your password. Please check your inbox." %}
    </p>
{% endblock %}
